# Copy to .env and fill in for your environment.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/bestellportal?schema=public"

# Signs the staff session cookie (JWT). Use a long random string in production,
# e.g. `openssl rand -base64 48`.
SESSION_SECRET="change-me-to-a-long-random-string"

# No SMTP / WhatsApp API credentials needed. "Informing the customer" opens a
# prefilled mailto: link (their default mail app) or a wa.me link
# (WhatsApp Web/App) - see src/lib/notifications/. There is nothing to
# configure here for that.
