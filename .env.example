# Copy to .env and fill in for your environment.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/bestellportal?schema=public"

# Signs the staff session cookie (JWT). Use a long random string in production,
# e.g. `openssl rand -base64 48`.
SESSION_SECRET="change-me-to-a-long-random-string"

# SMTP for the "your order is ready" transactional email. Leave empty in dev -
# the app logs the rendered email instead of sending and records a FAILED
# notification, so the rest of the flow stays testable without a mail server.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="City Kauf <bestellungen@citykauf.example>"

# WhatsApp Business API - prepared but not connected (see project brief §6).
# Once a provider (Meta Cloud API / Twilio / 360dialog) is chosen, wire it up
# in src/lib/notifications/whatsappChannel.ts using these credentials.
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
