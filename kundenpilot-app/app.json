{
  "expo": {
    "name": "KundenPilot",
    "slug": "kundenpilot-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kundenpilot",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#1E6F5C",
    "backgroundColor": "#F7F8F9",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "de.citykauf.kundenpilot",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KundenPilot nutzt deinen Standort, um dir eine Erinnerung zu senden, wenn du in der Nähe von Citykauf bist.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "KundenPilot nutzt deinen Standort im Hintergrund, um dir eine Erinnerung zu senden, wenn du in der Nähe von Citykauf bist.",
        "NSCameraUsageDescription": "Die Kamera wird an der Kasse zum Scannen des Kunden-Codes benötigt.",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "android": {
      "package": "de.citykauf.kundenpilot",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E6F5C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "KundenPilot nutzt deinen Standort, um dir eine Erinnerung zu senden, wenn du in der Nähe von Citykauf bist."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Die Kamera wird an der Kasse zum Scannen des Kunden-Codes benötigt."
        }
      ],
      "expo-task-manager",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
